<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Listed explicitly: build-setting shorthands can omit keys and leave the mic silent. -->

	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Covers both AVCaptureSession and AVAudioEngine input. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Built-in cameras, Continuity Camera and capture cards. -->
	<key>com.apple.security.device.camera</key>
	<true/>

	<!-- Save folder chosen in NSOpenPanel, kept as a security-scoped bookmark. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

</dict>
</plist>
